# Скопируй в .env и заполни. chmod 600 .env
# .env в git не коммитить.

# --- Telegram ---
BOT_TOKEN=123456:AA...
# Первый владелец. Остальных добавляют командой /owner или в админке
ADMIN_TG_ID=0

# --- Шифрование cookies ---
# Сгенерить: python -m db.init_db --key
# ВАЖНО: если сменишь ключ, все сохранённые cookies придётся заливать заново.
COOKIES_KEY=

# --- Веб-админка ---
# Секрет и пароль заполняет: python -m db.init_db --setup / --web-password
WEB_SECRET_KEY=
WEB_USER=admin
# Хэш: python -c "from werkzeug.security import generate_password_hash as g; print(g('пароль'))"
WEB_PASSWORD_HASH=
WEB_PORT=9000
# 0.0.0.0 — доступна из локальной сети, 127.0.0.1 — только с этой машины
WEB_HOST=0.0.0.0
